{
	"$schema": "https://turborepo.dev/schema.json",
	"extends": ["//"],
	"tasks": {
		"dev:prepare": {
			"cache": false,
			"inputs": [
				"src/schema/**",
				"drizzle/**",
				"drizzle.config.ts",
				"scripts/prepare-dev.ts",
				"scripts/migrations.ts",
				"scripts/check-drift.ts",
				"scripts/require-local-db.ts"
			],
			"passThroughEnv": [
				"ALLOW_REMOTE_DB",
				"DATABASE_URL",
				"DIRECT_DATABASE_URL",
				"POSTGRES_URL_NON_POOLING"
			]
		},
		"db:generate": {
			"cache": false,
			"interactive": true,
			"passThroughEnv": ["DATABASE_URL"]
		},
		"db:deploy": {
			"cache": false,
			"passThroughEnv": [
				"DATABASE_URL",
				"DIRECT_DATABASE_URL",
				"POSTGRES_URL_NON_POOLING"
			]
		},
		"db:migrate": {
			"cache": false,
			"interactive": true,
			"passThroughEnv": ["DATABASE_URL"]
		},
		"db:push": {
			"cache": false,
			"interactive": true,
			"passThroughEnv": ["DATABASE_URL"]
		},
		"db:reset": {
			"cache": false,
			"interactive": true,
			"passThroughEnv": ["DATABASE_URL"]
		},
		"db:seed": {
			"cache": false,
			"passThroughEnv": ["BLOB_READ_WRITE_TOKEN", "DATABASE_URL"]
		},
		"db:studio": {
			"cache": false,
			"persistent": true,
			"passThroughEnv": ["DATABASE_URL"]
		},
		"check-types": {
			"dependsOn": ["$TURBO_EXTENDS$"],
			"passThroughEnv": ["DATABASE_URL"]
		},
		"db:check": {
			"inputs": ["src/schema/**", "drizzle/**"]
		}
	}
}
