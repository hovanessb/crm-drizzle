{
	"name": "@crm/db",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./agent-tasks": "./src/agent-tasks.ts",
		"./attribution": "./src/attribution.ts",
		"./blob": "./src/blob.ts",
		"./client": "./src/client.ts",
		"./crm-events": "./src/crm-events.ts",
		"./currency": "./src/currency.ts",
		"./deal-stage": "./src/deal-stage.ts",
		"./enums": "./src/schema/enums.ts",
		"./errors": "./src/errors.ts",
		"./favicon": "./src/favicon.ts",
		"./fields": "./src/fields.ts",
		"./fields-shape": "./src/fields-shape.ts",
		"./fx": "./src/fx.ts",
		"./idempotency": "./src/idempotency.ts",
		"./images": "./src/images.ts",
		"./json": "./src/json.ts",
		"./safe-fetch": "./src/safe-fetch.ts",
		"./schema": "./src/schema/schema.ts",
		"./settings": "./src/settings.ts",
		"./settings-shape": "./src/settings-shape.ts",
		"./slack-inventory": "./src/slack-inventory.ts",
		"./tracking": "./src/tracking.ts",
		"./workspace": "./src/workspace.ts",
		"./workspace-shape": "./src/workspace-shape.ts"
	},
	"scripts": {
		"check-types": "tsc --noEmit",
		"db:check": "bun scripts/check-drift.ts",
		"db:deploy": "bun scripts/migrate.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "bun scripts/require-local-db.ts db:migrate && drizzle-kit generate && bun scripts/migrate.ts",
		"db:push": "bun scripts/require-local-db.ts db:push && drizzle-kit push",
		"db:reset": "bun scripts/require-local-db.ts db:reset && bun scripts/reset.ts",
		"db:seed": "bun scripts/require-local-db.ts db:seed && bun scripts/seed.ts",
		"db:studio": "drizzle-kit studio",
		"db:test": "bun scripts/test-db.ts",
		"test": "bun test",
		"dev:prepare": "bun scripts/prepare-dev.ts",
		"lint": "biome check .",
		"clean": "rm -rf .turbo node_modules"
	},
	"dependencies": {
		"@crm/env": "workspace:*",
		"@paralleldrive/cuid2": "^3.3.0",
		"@vercel/blob": "^2.6.1",
		"decimal.js": "^10.6.0",
		"drizzle-orm": "^0.45.4",
		"pg": "^8.22.0"
	},
	"devDependencies": {
		"@crm/typescript-config": "workspace:*",
		"@types/bun": "^1.4.4",
		"@types/node": "^24.10.1",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.11",
		"typescript": "5.9.2"
	}
}
